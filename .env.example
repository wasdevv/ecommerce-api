# Read by compose.yaml. Generate the two keys with:
#   echo "APP_KEY=base64:$(openssl rand -base64 32)" >> .env
#   echo "JWT_SECRET=$(openssl rand -base64 48)" >> .env
APP_KEY=
JWT_SECRET=

DB_PASSWORD=ecommerce

# Seeds admin@example.com and customer@example.com with this password. Empty = no demo users.
DEMO_PASSWORD=

# Empty = local payment mode. Set both to use Stripe Checkout (test keys are fine).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
